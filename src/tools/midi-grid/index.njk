        function updatePresetSelect() {
            const currentValue = presetSelect.value;
            presetSelect.innerHTML = '<option value="">-- Load --</option>';
            const names = Object.keys(presets).sort();
            for (const name of names) {
                const option = document.createElement('option');
                option.value = name;
                option.textContent = name;
                if (name === DEFAULT_PRESET_NAME) option.textContent = '0 ' + name;
                presetSelect.appendChild(option);
            }
            if (currentValue && presets[currentValue]) presetSelect.value = currentValue;
        }
        function exportPresets() {
            const data = JSON.stringify(presets, null, 2);
            const blob = new Blob([data], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `midi_grid_presets_${new Date().toISOString().slice(0,10)}.json`;
            a.click();
            URL.revokeObjectURL(url);
        }
        function importPresets(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (typeof imported === 'object' && !Array.isArray(imported)) {
                        const count = Object.keys(imported).length;
                        if (confirm(`Import ${count} presets? This will merge with your existing presets.`)) {
                            Object.assign(presets, imported);
                            if (!presets[DEFAULT_PRESET_NAME]) {
                                const defaultState = getDefaultState();
                                presets[DEFAULT_PRESET_NAME] = defaultState;
                            }
                            savePresetsToStorage();
                            updatePresetSelect();
                            showToast(`Imported ${count} presets successfully!`, 'success');
                        }
                    } else {
                        alert('Invalid preset file format.');
                    }
                } catch(err) {
                    alert('Error reading file: ' + err.message);
                }
            };
            reader.readAsText(file);
        }
        function updateGuitarRange() {
            const instrument = instrumentSelect.value;
            if (tuningInstruments.includes(instrument)) {
                const baseRange = tuningBaseRanges[instrument];
                if (baseRange) {
                    let offset = parseInt(guitarTuning.value);
                    let minOffset = offset;
                    if (dropTuningEnabled) minOffset -= 2;
                    guitarTuningOffset = offset;
                    instrumentRanges[instrument] = [baseRange[0] + minOffset, baseRange[1] + offset];
                    currentInstrumentRange = instrumentRanges[instrument];
                    updateStats(currentInstrumentRange);
                    autoAdjustOctaveSliders();
                    renderGrid();
                }
            }
        }
        function instrumentSelectChange() {
// Reset note search modes
    window._noteSearchMode = null;
    window._noteSearchRange = null;
    window._singleMidiNoteMode = null;
    window._singleMidiNote = null;
            const instrument = instrumentSelect.value;
            const isTunable = tuningInstruments.includes(instrument);
            isDrumMap = (instrument === 'gmdrums' || instrument === 'gmdrums2');
            if (instrument === 'gmdrums') currentDrumMap = gmDrumMap1;
            else if (instrument === 'gmdrums2') currentDrumMap = gmDrumMap2;
            else currentDrumMap = null;
            if (isTunable) {
                guitarControls.style.display = 'flex';
                const baseRange = tuningBaseRanges[instrument];
                if (baseRange) {
                    let offset = parseInt(guitarTuning.value);
                    let minOffset = offset;
                    if (dropTuningEnabled) minOffset -= 2;
                    instrumentRanges[instrument] = [baseRange[0] + minOffset, baseRange[1] + offset];
                    currentInstrumentRange = instrumentRanges[instrument];
                }
            } else {
                guitarControls.style.display = 'none';
                currentInstrumentRange = instrumentRanges[instrument] || instrumentRanges['all'];
            }
            updateStats(currentInstrumentRange);
            autoAdjustOctaveSliders();
            renderGrid();
saveCurrentState();
        }
        // Parse a note name without octave (e.g., "C", "Eb", "cs")
        function parseNoteName(input) {
            const normalized = normalizeNoteString(input);
            if (!normalized) return null;
