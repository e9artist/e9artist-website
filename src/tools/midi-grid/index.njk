            if (confirm(`Delete preset "${name}"?`)) {
                delete presets[name];
                savePresetsToStorage();
                updatePresetSelect();
                presetSelect.value = '';
                presetNameInput.value = '';
                currentPresetName = '';
saveCurrentState();
                showToast(`Preset "${name}" deleted.`, 'success');
