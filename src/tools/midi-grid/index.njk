                }
            });
            hidePanelsBtn.addEventListener('click', togglePanels);
            compactBtn.addEventListener('click', toggleCompactMode);
            rowHeightSelect.addEventListener('change', updateRowHeight);
            helpToggleBtn.addEventListener('click', toggleHelp);
            radioButtons.forEach(r => r.addEventListener('change', (e) => {
                currentNotation = e.target.value;
                updateRootSelect();
                renderCheckboxes();
                updateStats(currentInstrumentRange);
                renderGrid();
            }));
noteSearch.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        if (noteSearch.value.trim() !== '') {
            handleNoteSearch(noteSearch.value);
        }
        if (theorySearch.value.trim() !== '') {
            handleTheorySearch(theorySearch.value);
        }
    }
});
theorySearch.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        if (noteSearch.value.trim() !== '') {
            handleNoteSearch(noteSearch.value);
        }
        if (theorySearch.value.trim() !== '') {
            handleTheorySearch(theorySearch.value);
        }
    }
});
            document.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.key === 's') {
                    e.preventDefault();
                    const name = presetNameInput.value.trim() || prompt('Enter preset name:');
                    if (name) savePreset(name);
                }
                if (e.ctrlKey && e.key === 'r') {
                    e.preventDefault();
                    reloadPreset();
                }
                if (e.ctrlKey && e.key === 'd') {
                    e.preventDefault();
                    loadDefaultState();
                    showToast('Default preset loaded', 'success');
                }
                if (e.ctrlKey && e.key === 'h') {
                    e.preventDefault();
                    togglePanels();
                }
                if (e.ctrlKey && e.key === 'c') {
                    e.preventDefault();
                    toggleCompactMode();
                }
                if (e.ctrlKey && e.key === '1') {
                    e.preventDefault();
                    scaleSelect.value = "";
                    chordSelectVisible.value = "";
                    noteSearch.value = "";
                    theorySearch.value = "";
                    updateCheckboxesFromDropdown();
                }
                if (e.ctrlKey && e.key === '2') {
                    e.preventDefault();
                    instrumentSelect.value = "all";
                    instrumentSelectChange();
                    noteSearch.value = "";
                    theorySearch.value = "";
                    renderGrid();
                }
		if (e.key === '?') {
    		    e.preventDefault();
    		    toggleHelp();
		}
    		if (e.ctrlKey && e.key === 'm') {
		    e.preventDefault();
		    modeToggleBtn.click();
		}
		if (e.ctrlKey && e.key === 'u') {
	            e.preventDefault();
	            hueToggleBtn.click();
		}
	        if (e.ctrlKey && e.key === 'i') {
		    e.preventDefault();
		    intervalToggleBtn.click();
	        }
	        if (e.ctrlKey && e.key === 'f') {
	            e.preventDefault();
	            freqToggleBtn.click();
	        }
            });
            updateStats(currentInstrumentRange);
            instrumentSelectChange();
        }
        function initSlider() {
            function updateSlider() {
                let min = parseInt(sliderMin.value);
                let max = parseInt(sliderMax.value);
                if (min >= max) {
                    if (document.activeElement === sliderMin) {
                        sliderMin.value = max - 1;
                        min = max - 1;
                    } else {
                        sliderMax.value = min + 1;
                        max = min + 1;
                    }
                }
                minOctave = parseInt(sliderMin.value);
                maxOctave = parseInt(sliderMax.value);
                updateSliderDisplay();
                renderGrid();
            }
            sliderMin.addEventListener('input', updateSlider);
            sliderMax.addEventListener('input', updateSlider);
            updateSlider();
        }
        function renderCheckboxes() {
            checkboxGrid.innerHTML = '';
            const nameList = currentNotation === 'sharp' ? noteNamesSharp : noteNamesFlat;
            for (let i = 0; i < 12; i++) {
                const label = document.createElement('label');
                label.className = 'checkbox-item';
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.checked = activeCheckboxes[i];
                const scaleType = scaleSelect.value;
                const chordType = chordSelectVisible.value;
                let isAllowed = true;
                if (scaleType && scales[scaleType]) {
                    const interval = (i - currentRoot + 12) % 12;
                    isAllowed = scales[scaleType].includes(interval);
                } else if (chordType && chords[chordType]) {
                    const interval = (i - currentRoot + 12) % 12;
                    isAllowed = chords[chordType].includes(interval);
                }
                checkbox.checked = isAllowed && activeCheckboxes[i];
                checkbox.addEventListener('change', () => {
                    activeCheckboxes[i] = checkbox.checked;
                    renderGrid();
                });
                label.appendChild(checkbox);
                const span = document.createElement('span');
                span.textContent = nameList[i];
                label.appendChild(span);
                checkboxGrid.appendChild(label);
            }
saveCurrentState();
        }
        function updateCheckboxesFromDropdown() {
            const scaleType = scaleSelect.value;
            const chordType = chordSelectVisible.value;
            if (!scaleType && !chordType) {
                activeCheckboxes.fill(true);
            } else {
                let intervals = scaleType ? scales[scaleType] : chords[chordType];
                activeCheckboxes = activeCheckboxes.map((_, noteIdx) => {
                    const interval = (noteIdx - currentRoot + 12) % 12;
                    return intervals.includes(interval);
                });
            }
            renderCheckboxes();
            renderGrid();
saveCurrentState();
        }
        function getHueColor(interval) {
            const hue = (interval * 30) % 360;
            return `hsl(${hue}, 70%, 50%)`;
        }
        function renderGrid() {
    const nameList = currentNotation === 'sharp' ? noteNamesSharp : noteNamesFlat;
    octaveGrid.innerHTML = '';
    const scaleType = scaleSelect.value;
    const chordType = chordSelectVisible.value;
    let allowedIntervals = null;
    if (scaleType && scales[scaleType]) allowedIntervals = scales[scaleType];
    else if (chordType && chords[chordType]) allowedIntervals = chords[chordType];
    let octaveIndex = 0;
    for (let oct = 9; oct >= -1; oct--) {
        const row = document.createElement('div');
        row.className = 'octave-row';
        if (compactMode) row.classList.add('compact');
        const inSliderRange = oct >= minOctave && oct <= maxOctave;
        if (!inSliderRange) {
            row.classList.add('hidden-row');
            octaveIndex++;
            continue;
        }
        if (displayMode === 'strict' && currentInstrumentRange[0] !== 0) {
            const octaveStartMidi = (oct + 1) * 12;
            const octaveEndMidi = octaveStartMidi + 11;
            const isOctaveInRange = !(octaveEndMidi < currentInstrumentRange[0] || octaveStartMidi > currentInstrumentRange[1]);
            if (!isOctaveInRange) {
                row.classList.add('hidden-row');
                octaveIndex++;
                continue;
            }
        }
        const label = document.createElement('div');
        label.className = 'octave-label';
        if (compactMode) {
            label.innerHTML = `<span>${oct}</span>`;
        } else {
            label.textContent = `Octave ${oct}`;
        }
        row.appendChild(label);
        for (let noteIdx = 0; noteIdx < 12; noteIdx++) {
            const midiNum = (oct + 1) * 12 + noteIdx;
            if (midiNum < 0 || midiNum > 127) {
                const ph = document.createElement('div');
                ph.style.visibility = 'hidden';
                row.appendChild(ph);
                continue;
            }
            const noteName = nameList[noteIdx] + oct;
            const isCheckboxActive = activeCheckboxes[noteIdx];
            let isTheoryActive = true;
            let currentInterval = -1;
            if (allowedIntervals) {
                currentInterval = (noteIdx - currentRoot + 12) % 12;
                isTheoryActive = allowedIntervals.includes(currentInterval);
            }
            let isInRange = true;
            if (currentInstrumentRange) {
                isInRange = midiNum >= currentInstrumentRange[0] && midiNum <= currentInstrumentRange[1];
            }
            // Check if we're in note search range mode
            let isInSearchRange = true;
            if (window._noteSearchMode === 'range' && window._noteSearchRange) {
                const [searchMin, searchMax] = window._noteSearchRange;
                isInSearchRange = midiNum >= searchMin && midiNum <= searchMax;
            }
            // Check if we're in single MIDI note mode
            let isSingleMidiNote = false;
            if (window._singleMidiNoteMode && window._singleMidiNote !== null) {
                isSingleMidiNote = midiNum === window._singleMidiNote;
            }
            
            // Determine the note's status
            const isActive = isCheckboxActive && isTheoryActive && isInRange && isInSearchRange && (isSingleMidiNote || !window._singleMidiNoteMode);
            
            // Special case: single MIDI note that's OUTSIDE the instrument range
            const isOutsideSingleNote = window._singleMidiNoteMode && isSingleMidiNote && !isInRange;
            
            const isInRangeButNotActive = isInRange && !isActive && !isOutsideSingleNote;
            
            const card = document.createElement('div');
card.className = 'note-card';
card.dataset.interval = currentInterval;
// Add click handler for audio playback
card.addEventListener('click', function(e) {
    e.stopPropagation();
    // Only play if the note is within the instrument range or is an outside-range highlight
    if (isInRange || isOutsideSingleNote) {
        playNote(midiNum, 0.8);
    }
saveCurrentState();
});
// Add hover effect for visual feedback
card.addEventListener('mouseenter', function() {
    if (isInRange || isOutsideSingleNote) {
        this.style.cursor = 'pointer';
        this.style.opacity = '0.8';
    }
});
card.addEventListener('mouseleave', function() {
    if (isInRange || isOutsideSingleNote) {
        this.style.opacity = '1';
    }
});
            
            if (isActive) {
                card.classList.add('active');
            } else if (isOutsideSingleNote) {
                // This is a searched note outside the range - highlight in purple/magenta
                card.classList.add('active');
                card.style.backgroundColor = '#9b59b6';
                card.style.borderColor = '#9b59b6';
                card.style.color = '#fff';
                // Add a special class for styling
                card.classList.add('outside-range-highlight');
            } else if (isInRangeButNotActive) {
                card.classList.add('in-range-dimmed');
            } else {
                card.classList.add('dimmed');
            }
            
            if (isDrumMap && currentDrumMap && currentDrumMap[midiNum]) {
                const drumCat = getDrumCategory(midiNum, currentDrumMap);
                card.classList.add('drum-' + drumCat);
            }
            if (isActive && showHue && currentInterval !== -1) {
                card.style.backgroundColor = getHueColor(currentInterval);
                card.style.borderColor = getHueColor(currentInterval);
                card.style.color = '#fff';
card.classList.add('hue-mode'); // Add class for CSS targeting
            }
            if (compactMode) card.style.height = rowHeight + 'px';
            let htmlContent = '<div class="note-content">';
            htmlContent += '<div class="note-top-row">';
            htmlContent += `<span class="note-name">${noteName}</span>`;
            if (showIntervals && currentInterval !== -1 && isActive && allowedIntervals) {
                let intLabel = intervalNames[currentInterval];
                if (currentInterval === 6 && scaleType === 'lydian') intLabel = "#11";
                if (currentInterval === 8 && chordType === 'dominant7flat13') intLabel = "b13";
                if (currentInterval === 1 && chordType === 'dominant7flat9') intLabel = "b9";
                htmlContent += `<span class="note-interval">${intLabel}</span>`;
            }
            htmlContent += '</div>';
            if (isDrumMap && currentDrumMap && currentDrumMap[midiNum]) {
                htmlContent += '<div class="note-middle-row">';
                htmlContent += `<span class="drum-name">${getDrumShortName(midiNum, currentDrumMap)}</span>`;
                htmlContent += '</div>';
            }
            htmlContent += '<div class="note-bottom-row">';
            if (showFreq) {
                const freq = getFrequency(midiNum).toFixed(2);
                htmlContent += `<span class="note-freq">${freq} Hz</span>`;
            } else {
                htmlContent += `<span class="note-number">${midiNum}</span>`;
            }
            htmlContent += '</div>';
            htmlContent += '</div>';
            card.innerHTML = htmlContent;
            row.appendChild(card);
        }
        octaveGrid.appendChild(row);
        octaveIndex++;
    }
}
        rootSelect.addEventListener('change', (e) => {
            currentRoot = parseInt(e.target.value);
            if (scaleSelect.value || chordSelectVisible.value) updateCheckboxesFromDropdown();
            else renderGrid();
        });
        scaleSelect.addEventListener('change', () => {
            chordSelectVisible.value = "";
            noteSearch.value = "";
            theorySearch.value = "";
            updateCheckboxesFromDropdown();
        });
        chordSelectVisible.addEventListener('change', () => {
            scaleSelect.value = "";
            noteSearch.value = "";
            theorySearch.value = "";
            updateCheckboxesFromDropdown();
        });
        resetScaleChordBtn.addEventListener('click', () => {
            scaleSelect.value = "";
            chordSelectVisible.value = "";
            noteSearch.value = "";
            theorySearch.value = "";
            updateCheckboxesFromDropdown();
        });
        resetInstrumentBtn.addEventListener('click', () => {
    window._noteSearchMode = null;
    window._noteSearchRange = null;
    window._singleMidiNoteMode = null;
    window._singleMidiNote = null;
    instrumentSelect.value = "all";
    instrumentSelectChange();
    noteSearch.value = "";
    theorySearch.value = "";
    renderGrid();
});
        selectAllBtn.addEventListener('click', () => {
            activeCheckboxes.fill(true);
            scaleSelect.value = "";
            chordSelectVisible.value = "";
            noteSearch.value = "";
            theorySearch.value = "";
            renderCheckboxes();
            renderGrid();
        });
        deselectAllBtn.addEventListener('click', () => {
            activeCheckboxes.fill(false);
            scaleSelect.value = "";
            chordSelectVisible.value = "";
            noteSearch.value = "";
            theorySearch.value = "";
            renderCheckboxes();
            renderGrid();
        });
        resetSliderBtn.addEventListener('click', () => {
            sliderMin.value = -1;
            sliderMax.value = 9;
            sliderMin.dispatchEvent(new Event('input'));
            minOctave = -1;
            maxOctave = 9;
            updateSliderDisplay();
            renderGrid();
        });
        modeToggleBtn.addEventListener('click', () => {
            if (displayMode === 'full') {
                displayMode = 'strict';
                modeToggleBtn.textContent = "Mode: Instr.";
                modeToggleBtn.classList.add('active-toggle');
                autoAdjustOctaveSliders();
            } else {
                displayMode = 'full';
                modeToggleBtn.textContent = "Mode: Full";
                modeToggleBtn.classList.remove('active-toggle');
            }
            renderGrid();
        });
hueToggleBtn.addEventListener('click', () => {
    showHue = !showHue;
    hueToggleBtn.classList.toggle('active-toggle', showHue);
    renderGrid(); // Just re-render - the renderGrid function handles hue colors
});
        intervalToggleBtn.addEventListener('click', () => {
            showIntervals = !showIntervals;
            intervalToggleBtn.classList.toggle('active-toggle', showIntervals);
            renderGrid();
        });
        freqToggleBtn.addEventListener('click', () => {
            showFreq = !showFreq;
            freqToggleBtn.classList.toggle('active-toggle', showFreq);
            renderGrid();
        });
        init();
