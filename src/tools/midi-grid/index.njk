        function savePreset(name) {
            if (!name.trim()) {
                showToast('Please enter a preset name', 'warning');
                return;
            }
            if (name === DEFAULT_PRESET_NAME) {
                showToast('Cannot save over the Default preset', 'warning');
                return;
            }
            if (presets[name] && !confirm(`Preset "${name}" already exists. Overwrite?`)) {
                return;
            }
            presets[name] = getCurrentState();
            savePresetsToStorage();
            updatePresetSelect();
            presetSelect.value = name;
            currentPresetName = name;
saveCurrentState();
            showToast(`Preset "${name}" reloaded!`, 'success');
        }
        function reloadPreset() {
            const name = presetSelect.value;
            if (!name || !presets[name]) {
                alert('Please select a preset to reload');
                return;
            }
            if (confirm(`Reload preset "${name}"? This will revert any changes made since loading.`)) {
                applyState(presets[name]);
                presetSelect.value = name;
                presetNameInput.value = name;
                currentPresetName = name;
saveCurrentState();
                showToast(`Preset "${name}" reloaded!`, 'success');
            }
        }
        function renamePreset(oldName, newName) {
            if (!oldName || !presets[oldName]) {
                alert('Please select a preset to rename');
                return;
            }
            if (oldName === DEFAULT_PRESET_NAME) {
                alert('Cannot rename the Default preset');
                return;
            }
            if (!newName || !newName.trim()) {
                alert('Please enter a new name');
                return;
            }
            newName = newName.trim();
            if (oldName === newName) {
                alert('New name is the same as the old name');
                return;
            }
            if (newName === DEFAULT_PRESET_NAME) {
                alert('Cannot rename to Default');
                return;
            }
            if (presets[newName]) {
                if (!confirm(`Preset "${newName}" already exists. Overwrite?`)) {
                    return;
                }
            }
            presets[newName] = presets[oldName];
            delete presets[oldName];
            savePresetsToStorage();
            updatePresetSelect();
            presetSelect.value = newName;
            presetNameInput.value = newName;
            currentPresetName = newName;
saveCurrentState();
            showToast(`Preset renamed from "${oldName}" to "${newName}"!`, 'success');
        }
        function loadPreset(name) {
            if (!name || !presets[name]) return;
            if (confirm(`Load preset "${name}"? This will replace your current settings.`)) {
                applyState(presets[name]);
                presetSelect.value = name;
                presetNameInput.value = name;
                currentPresetName = name;
saveCurrentState();
            }
