                const maxOct = Math.floor(maxMidi / 12) - 1;
                const newMin = Math.max(-1, Math.min(9, minOct));
                const newMax = Math.max(-1, Math.min(9, maxOct));
                if (newMin !== minOctave || newMax !== maxOctave) {
                    minOctave = newMin;
                    maxOctave = newMax;
                    sliderMin.value = newMin;
                    sliderMax.value = newMax;
                    updateSliderDisplay();
