        if (displayMode === 'strict') {
            const minOct = Math.floor(rangeResult.min / 12) - 1;
            const maxOct = Math.floor(rangeResult.max / 12) - 1;
            minOctave = Math.max(-1, Math.min(9, minOct));
            maxOctave = Math.max(-1, Math.min(9, maxOct));
            sliderMin.value = minOctave;
            sliderMax.value = maxOctave;
