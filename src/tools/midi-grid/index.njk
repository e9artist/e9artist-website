    const rangeMatch = input.match(/^([^-]+)-(.+)$/);
    if (!rangeMatch) {
        //console.log('No range match found');
        return null;
    }
    const left = rangeMatch[1].trim();
    const right = rangeMatch[2].trim();
    //console.log('Left:', left, 'Right:', right);
    // Check if both sides are MIDI numbers
    const leftNum = parseInt(left);
    const rightNum = parseInt(right);
    if (!isNaN(leftNum) && !isNaN(rightNum) && leftNum >= 0 && leftNum <= 127 && rightNum >= 0 && rightNum <= 127) {
        const result = { min: Math.min(leftNum, rightNum), max: Math.max(leftNum, rightNum) };
        //console.log('MIDI number range:', result);
        return result;
    }
    // Try as note names with proper case-insensitive handling
    const leftMidi = noteToMidi(left);
    const rightMidi = noteToMidi(right);
    //console.log('Left MIDI:', leftMidi, 'Right MIDI:', rightMidi);
    if (leftMidi !== null && rightMidi !== null) {
        const result = { min: Math.min(leftMidi, rightMidi), max: Math.max(leftMidi, rightMidi) };
        //console.log('Note name range:', result);
        return result;
    }
    //console.log('No valid range found');
    return null;
}
function handleNoteSearch(input) {
    const trimmed = input.trim();
