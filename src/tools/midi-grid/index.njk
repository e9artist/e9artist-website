        function updateStats(range) {
            if (!range || range.length < 2) {
                rangeStats.textContent = '-';
                widthStats.textContent = '-';
                octaveStats.textContent = '-';
                return;
            }
            const [min, max] = range;
            const nameList = currentNotation === 'sharp' ? noteNamesSharp : noteNamesFlat;
            const minOctave = Math.floor(min / 12) - 1;
            const maxOctave = Math.floor(max / 12) - 1;
            const minNote = nameList[min % 12];
            const maxNote = nameList[max % 12];
            rangeStats.textContent = `${minNote}${minOctave} (${min}) to ${maxNote}${maxOctave} (${max})`;
            const width = max - min + 1;
            widthStats.textContent = `${width} semitones`;
            const octaves = width / 12;
            const wholeOctaves = Math.floor(octaves);
            const remainingSemis = Math.round((octaves - wholeOctaves) * 12);
            if (remainingSemis === 0) {
                if (wholeOctaves === 0) octaveStats.textContent = `< 1 octave`;
                else octaveStats.textContent = `${wholeOctaves} octaves`;
            } else {
                octaveStats.textContent = `${wholeOctaves} octaves + ${remainingSemis}/12`;
            }
        }
