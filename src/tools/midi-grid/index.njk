            currentRoot = noteIdx;
            
            scaleSelect.value = "";
            chordSelectVisible.value = "";
            renderCheckboxes();
            renderGrid();
            noteSearch.value = "";
        }
saveCurrentState();
        return;
    }
    // Try as single note name (no octave) - e.g., "C", "Eb", "cs"
    // This should select ALL octaves of that note within the instrument range
    const singleNote = parseNoteName(trimmed);
    if (singleNote) {
