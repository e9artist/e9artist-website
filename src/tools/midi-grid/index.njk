    // Try as a single note with octave (e.g., "C6", "Eb-1", "c#2")
    // This should select ONLY that specific note
    const midiNum = noteToMidi(trimmed);
    if (midiNum !== null && midiNum >= 0 && midiNum <= 127) {
        // Clear any note search range
        window._noteSearchMode = null;
        window._noteSearchRange = null;
        
        // Get the note index from the MIDI number
