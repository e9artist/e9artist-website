                if (data) {
                    presets = JSON.parse(data);
                    if (!presets[DEFAULT_PRESET_NAME]) {
                        const defaultState = getDefaultState();
                        applyState(defaultState);
                        presets[DEFAULT_PRESET_NAME] = defaultState;
                        savePresetsToStorage();
                    }
                    updatePresetSelect();
                } else {
                    const defaultState = getDefaultState();
                    applyState(defaultState);
                    presets[DEFAULT_PRESET_NAME] = defaultState;
                    savePresetsToStorage();
                    updatePresetSelect();
                }
            } catch(e) {
                presets = {};
