        function normalizeNoteString(noteStr) {
    if (!noteStr) return null;
    let normalized = noteStr.toUpperCase().trim();
    if (normalized.length === 1) {
        return normalized;
    }
    const letter = normalized[0];
    let accidental = normalized.slice(1);
    if (accidental === 'S') accidental = '#';
    if (accidental === 'B') accidental = 'b';
    if (accidental !== '#' && accidental !== 'b' && accidental !== '') {
        return null;
    }
    return letter + accidental;
}
        function noteToMidi(noteStr) {
    if (!noteStr) return null;
    // Match pattern: letter, optional accidental (#, b, or s), optional octave
    const match = noteStr.match(/^([A-G])([#bs]?)(-?\d+)$/i);
    if (!match) return null;
    const letter = match[1].toUpperCase();
    let accidental = match[2].toLowerCase();
    const octave = parseInt(match[3]);
    // Map 's' to '#'
    if (accidental === 's') accidental = '#';
    if (accidental === 'b') accidental = 'b';
