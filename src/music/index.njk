    border-radius: 5px;
}

#playlist li.active .song-title {
    color: var(--active-text);
}

#playlist li.active .song-duration {
    color: var(--secondary-text);
}

#playlist li.active::before {
    content: "▶";
    position: absolute;
    left: -5px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.7em;
    color: var(--link-color);
}

#playlist li .play-indicator {
    display: none;
    position: absolute;
    left: -5px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.7em;
    color: var(--link-color);
}

#playlist li.active .play-indicator {
    display: block;
}

/* Library items */
#library li {
    cursor: pointer;
}

#library li:hover {
    background-color: var(--playlist-hover);
}

