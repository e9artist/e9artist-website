// ============================================================
// URL SEARCH PARAMETER HANDLING - ENHANCED
// ============================================================
function getSearchParams() {
    const urlParams = new URLSearchParams(window.location.search);
    return {
        search: urlParams.get('search') || '',
        searchAlbum: urlParams.get('searchalbum') || '',
        searchSong: urlParams.get('searchsong') || '',
        autoplay: urlParams.get('autoplay') === 'true' || false
    };
}

function handleSearchParams() {
    const params = getSearchParams();
    let searchTerm = '';
    
    // Priority 1: If both album and song are specified, do exact matching
    if (params.searchAlbum && params.searchSong) {
        const exactSection = decodeURIComponent(params.searchAlbum).trim();
        const exactSong = decodeURIComponent(params.searchSong).trim();
        
        window._exactMatchMode = true;
        window._exactSection = exactSection;
        window._exactSong = exactSong;
        window._autoPlay = params.autoplay || false;
        
        searchTerm = `"${exactSection}" → "${exactSong}"`;
        
    } else if (params.search) {
        // Normal search
        searchTerm = decodeURIComponent(params.search);
        window._exactMatchMode = false;
        window._exactSection = null;
        window._exactSong = null;
        window._autoPlay = params.autoplay || false;
    } else {
        window._exactMatchMode = false;
        window._exactSection = null;
        window._exactSong = null;
        window._autoPlay = false;
        return;
    }
    
    // Populate the search input
    const searchInput = document.getElementById('librarySearch');
    if (searchInput) {
        searchInput.value = searchTerm;
        searchQuery = searchTerm;
        const clearBtn = document.getElementById('clearSearchBtn');
        if (clearBtn) {
            clearBtn.style.display = 'inline-block';
        }
        renderLibrary();
    }
}
// ============================================================
// SHAREABLE SEARCH LINK - UPDATED
// ============================================================
function getShareableLink() {
    const searchInput = document.getElementById('librarySearch');
    
    // If we're in exact match mode, use those parameters
    if (window._exactMatchMode && window._exactSection && window._exactSong) {
        const encodedSection = encodeURIComponent(window._exactSection);
        const encodedSong = encodeURIComponent(window._exactSong);
        let link = `${window.location.origin}${window.location.pathname}?searchalbum=${encodedSection}&searchsong=${encodedSong}`;
        if (window._autoPlay) {
            link += '&autoplay=true';
        }
        return link;
    }
    
    // Otherwise, use the regular search
    if (searchInput && searchInput.value.trim()) {
        const encoded = encodeURIComponent(searchInput.value.trim());
        let link = `${window.location.origin}${window.location.pathname}?search=${encoded}`;
        if (window._autoPlay) {
            link += '&autoplay=true';
        }
        return link;
    }
    
    return window.location.href;
}

function copyShareableLink() {
    const link = getShareableLink();
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(link).then(() => {
            showToast('Shareable link copied to clipboard! 📋', 'success');
        }).catch(() => {
            copyLinkFallback(link);
        });
    } else {
        copyLinkFallback(link);
    }
}

function copyLinkFallback(link) {
    const textarea = document.createElement('textarea');
    textarea.value = link;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    try {
        document.execCommand('copy');
        showToast('Shareable link copied to clipboard! 📋', 'success');
    } catch (err) {
        showToast('Copy failed. Please copy the URL manually.', 'error');
    }
    document.body.removeChild(textarea);
}

