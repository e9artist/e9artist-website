}

/* Progress bar */
.progress-container {
    margin-bottom: 20px;
}

.progress-bar {
    height: 6px;
    background: var(--border-color);
    border-radius: 3px;
    cursor: pointer;
    position: relative;
}

.progress {
    height: 100%;
    background: var(--link-color);
