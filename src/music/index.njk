---
title: "Music"
layout: "base.njk"
---

<div class="header-section" id="headerSection">
    <div class="header-toggle">
        <h1 class="page-title">My Music</h1>
    </div>
    <p class="page-description" id="headerDescription" style="font-size: 0.85em; line-height: 1.4; margin-bottom: 10px;">Some of my recordings! The default playlist features my latest songs/mixes with older songs being pushed to this page's library. You can customize your playlist by adding or removing songs below. Your browser will save the playlist for you and best of all, no ads! Click a section name to expand/collapse it. Click the Load All buttons to load entire sections or add individual files by clicking the ➕ button. Also, you can hide this message by pressing that ➕ button next to the song title dirctly below!</p>
</div>

<section class="music-player">
    <div class="player-controls">
        <div class="player-header">
            <button id="toggleHeaderBtn" class="toggle-header-btn" title="Toggle header">−</button>
            <h3 id="now-playing">Keep It Movin'</h3>
        </div>
        <audio id="audio-player" autoplay>
            <source src="https://www.dropbox.com/scl/fi/uhnna7uuafykg4o4omlrl/Keep-It-Movin-by-E9-20260902v1.mp3?rlkey=5dnj53awekqvwatmkiwsehbcl&st=r2u77ab3&raw=1" type="audio/mpeg">
            Your browser does not support audio.
        </audio>
        
        <!-- Progress Bar -->
        <div class="progress-container">
            <div class="progress-bar" id="progress-bar">
                <div class="progress" id="progress"></div>
            </div>
            <div class="time-info">
                <span id="current-time">0:00</span>
                <span id="total-time">0:00</span>
            </div>
        </div>
        
        <!-- Controls -->
        <div class="controls">
            <button onclick="toggleShuffle()" id="shuffle-btn" title="Shuffle (S)">🔀</button>
            <button onclick="playPrev()" title="Previous (←)">⏮</button>
            <button onclick="togglePlay()" id="play-btn" title="Play/Pause (Space)">⏸</button>
            <button onclick="playNext()" title="Next (→)">⏭</button>
            <button onclick="toggleRepeat()" id="repeat-btn" title="Repeat (R)">🔁</button>
        </div>
        
        <!-- Volume Control -->
        <div class="volume-control">
            <span>🔊</span>
            <input type="range" min="0" max="1" step="0.01" value="0.8" id="volume-control">
        </div>
    </div>

    <!-- Custom Playlist Section -->
    <div class="playlist-section">
        <div class="playlist-header">
            <h3>Now Playing <span id="playlist-status">(4 songs)</span></h3>
            <div class="playlist-actions">
                <button onclick="clearPlaylist()" class="action-btn" title="Clear Playlist">🗑️ Clear</button>
                <button onclick="resetPlaylist()" class="action-btn" title="Reset to Default">↩️ Reset</button>
            </div>
        </div>
        <ul id="playlist">
            <!-- Playlist items will be rendered here -->
        </ul>
    </div>

    <!-- Library Section -->
    <div class="library-section">
        <div class="library-header">
            <div class="library-title-container">
                <div class="library-title-row">
                    <h3>All Songs <span id="library-count">(8 songs)</span></h3>
                    <button id="loadAllBtn" class="load-all-btn" title="Add all songs to playlist">➕ Load All Songs</button>
                </div>
                <div class="library-search-row">
                    <div class="library-search">
                        <input type="text" id="librarySearch" placeholder="🔍 Search..." class="search-input">
                        <button id="clearSearchBtn" class="clear-search-btn" style="display:none;">✕</button>
                    </div>
                    <p class="library-hint">Click ➕ to add a song to your playlist, or click on a song title to play it immediately.</p>
                </div>
            </div>
        </div>
        <div id="library">
            <!-- Library items with headers will be rendered here -->
        </div>
    </div>
</section>

