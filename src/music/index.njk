        title: "Make Believe (No Guitar Version)",
        file: "https://www.dropbox.com/scl/fi/yky7y8nkun4ijbv5apqyi/Make-Believe-No-Guitar-4.mp3?rlkey=sw99znjnwvow3ji8c30xt22m2&st=g4fo7pg8&raw=1",
        duration: "5:55",
        section: "Alien Thoughts EP (Backing Tracks)"
    },
    {
        id: 6,
        title: "The Uncanny Valley (No Guitar Version)",
        file: "https://www.dropbox.com/scl/fi/zglq0xort8f1u9tfgtaxq/The-Uncanny-Valley-No-Guitar-v2.mp3?rlkey=tm5oatjtfu9vx29n9qqr196mi&st=rzgoczt6&raw=1",
        duration: "5:17",
        section: "Alien Thoughts EP (Backing Tracks)"
    },
    {
        id: 7,
        title: "Tearing Down The Temple (No Guitar Version)",
        file: "https://www.dropbox.com/scl/fi/ncmv9ruugocwtlgl6w1cw/TDTT-Master-No-Guitar-v1.mp3?rlkey=9kt3djfh21t7437ewh2rtjd34&st=j1dnphdz&raw=1",
        duration: "9:29",
        section: "Alien Thoughts EP (Backing Tracks)"
    }
];

// ============================================================
// DEFAULT PLAYLIST - Set your default playlist here
// (Use the song IDs from allSongs)
// ============================================================
const DEFAULT_PLAYLIST_IDS = [0, 1, 2, 3]; // Your latest/recommended songs

// ============================================================
// PLAYER STATE
// ============================================================
let currentPlaylist = [];
let currentTrackIndex = 0;
let isShuffled = false;
let repeatMode = 'none';
let shuffledOrder = [];
let currentShuffledIndex = 0;

// ============================================================
// DOM ELEMENTS
// ============================================================
const audio = document.getElementById('audio-player');
const nowPlaying = document.getElementById('now-playing');
const playlistEl = document.getElementById('playlist');
const libraryEl = document.getElementById('library');
const playlistStatus = document.getElementById('playlist-status');
const libraryCount = document.getElementById('library-count');
const playBtn = document.getElementById('play-btn');
const shuffleBtn = document.getElementById('shuffle-btn');
const repeatBtn = document.getElementById('repeat-btn');
const progress = document.getElementById('progress');
const progressBar = document.getElementById('progress-bar');
const currentTimeDisplay = document.getElementById('current-time');
const totalTimeDisplay = document.getElementById('total-time');
const volumeControl = document.getElementById('volume-control');

// ============================================================
// HELPER FUNCTIONS
// ============================================================
function getSongById(id) {
    return allSongs.find(song => song.id === id);
}

function getSongsByIds(ids) {
    return ids.map(id => getSongById(id)).filter(song => song !== undefined);
}

function savePlaylist() {
    const ids = currentPlaylist.map(song => song.id);
    localStorage.setItem('customPlaylist', JSON.stringify(ids));
}

function loadSavedPlaylist() {
    const saved = localStorage.getItem('customPlaylist');
    if (saved) {
        try {
            const ids = JSON.parse(saved);
            const songs = getSongsByIds(ids);
            if (songs.length > 0) {
                return songs;
            }
        } catch (e) {}
    }
    return null;
}

function getPlaylist() {
    const saved = loadSavedPlaylist();
    return saved || getSongsByIds(DEFAULT_PLAYLIST_IDS);
}

// ============================================================
// RENDER FUNCTIONS
// ============================================================
function renderPlaylist() {
    playlistEl.innerHTML = '';
    
    if (currentPlaylist.length === 0) {
        playlistEl.innerHTML = '<li style="text-align:center; color:var(--secondary-text); padding:20px; cursor:default;">No songs in playlist. Add some from the library below! 🎵</li>';
        playlistStatus.textContent = '(0 songs)';
        return;
    }
    
    currentPlaylist.forEach((song, index) => {
        const li = document.createElement('li');
        li.dataset.index = index;
        li.className = index === currentTrackIndex ? 'active' : '';
        
        li.innerHTML = `
            <div class="song-info">
                <span class="play-indicator">▶</span>
                <span class="song-title">${song.title}</span>
            </div>
            <span class="song-duration">${song.duration}</span>
            <button class="remove-btn" onclick="removeFromPlaylist(${index})" title="Remove from playlist">✕</button>
        `;
        
        playlistEl.appendChild(li);
    });
    
    playlistStatus.textContent = `(${currentPlaylist.length} songs)`;
    updateActiveHighlight();
}

function renderLibrary() {
    libraryEl.innerHTML = '';
    
    const playlistIds = currentPlaylist.map(song => song.id);
    
    // Group songs by section
    const sections = {};
    allSongs.forEach(song => {
        const sectionName = song.section || 'Other';
        if (!sections[sectionName]) {
            sections[sectionName] = [];
        }
        sections[sectionName].push(song);
    });
    
    // Render each section
    Object.keys(sections).forEach(sectionName => {
        const songsInSection = sections[sectionName];
        const allInPlaylist = songsInSection.every(song => playlistIds.includes(song.id));
        const noneInPlaylist = songsInSection.every(song => !playlistIds.includes(song.id));
        
        // Add section header with "Load All" button
        const header = document.createElement('div');
        header.className = 'library-header';
        
        const headerText = document.createElement('span');
        headerText.textContent = sectionName;
        header.appendChild(headerText);
        
        // Only show "Load All" button if not all songs are already in the playlist
        if (!allInPlaylist) {
            const loadBtn = document.createElement('button');
            loadBtn.className = 'load-section-btn';
            loadBtn.textContent = noneInPlaylist ? '➕ Load All' : '➕ Add Missing';
            loadBtn.onclick = function(e) {
                e.stopPropagation();
                loadSectionToPlaylist(sectionName);
            };
            header.appendChild(loadBtn);
        } else {
            const badge = document.createElement('span');
            badge.style.cssText = 'font-size:0.6em; color:var(--secondary-text); font-weight:normal;';
            badge.textContent = '✅ All loaded';
            header.appendChild(badge);
        }
        
        libraryEl.appendChild(header);
        
        // Add songs in this section
        const ul = document.createElement('ul');
        songsInSection.forEach(song => {
            const li = document.createElement('li');
            const isInPlaylist = playlistIds.includes(song.id);
            
            li.innerHTML = `
                <span class="song-title">${song.title}</span>
                <span class="song-duration">${song.duration}</span>
                ${isInPlaylist 
                    ? '<span class="added-badge">✅ In Playlist</span>'
                    : `<button class="add-btn" onclick="addToPlaylist(${song.id})" title="Add to playlist">➕</button>`
                }
            `;
            
            // Click on the song to play it immediately
            li.addEventListener('click', function(e) {
                if (e.target.tagName === 'BUTTON') return;
                
                const playlistIndex = currentPlaylist.findIndex(s => s.id === song.id);
                if (playlistIndex !== -1) {
                    loadTrack(playlistIndex);
                } else {
                    addToPlaylist(song.id);
                    const newIndex = currentPlaylist.findIndex(s => s.id === song.id);
                    if (newIndex !== -1) {
                        loadTrack(newIndex);
                    }
                }
            });
            
            ul.appendChild(li);
        });
        libraryEl.appendChild(ul);
    });
    
    libraryCount.textContent = `(${allSongs.length} songs)`;
}

function loadSectionToPlaylist(sectionName) {
    const songsInSection = allSongs.filter(song => song.section === sectionName);
    let addedCount = 0;
    
    songsInSection.forEach(song => {
        if (!currentPlaylist.some(s => s.id === song.id)) {
            currentPlaylist.push(song);
            addedCount++;
        }
    });
    
    if (addedCount > 0) {
        savePlaylist();
        renderPlaylist();
        renderLibrary();
        
        // Auto-play the first song of the section if playlist was empty
        if (currentPlaylist.length === songsInSection.length) {
            // Find where the first added song is in the playlist
            const firstSongIndex = currentPlaylist.findIndex(s => s.id === songsInSection[0].id);
            if (firstSongIndex !== -1) {
                loadTrack(firstSongIndex);
            }
        }
    }
}

function updateActiveHighlight() {
    const items = playlistEl.querySelectorAll('li');
    items.forEach((item, index) => {
        item.classList.toggle('active', index === currentTrackIndex);
    });
}

// ============================================================
// PLAYLIST MANAGEMENT
// ============================================================
function addToPlaylist(songId) {
    const song = getSongById(songId);
    if (!song) return;
    if (currentPlaylist.some(s => s.id === songId)) return;
    
    currentPlaylist.push(song);
    savePlaylist();
    renderPlaylist();
    renderLibrary();
}

function removeFromPlaylist(index) {
    if (index < 0 || index >= currentPlaylist.length) return;
    
    currentPlaylist.splice(index, 1);
    savePlaylist();
    
    if (index === currentTrackIndex) {
        if (currentPlaylist.length === 0) {
            audio.pause();
            nowPlaying.textContent = 'No songs in playlist';
            playBtn.textContent = '▶';
            renderPlaylist();
            renderLibrary();
            return;
        } else if (index >= currentPlaylist.length) {
            currentTrackIndex = currentPlaylist.length - 1;
        } else {
            currentTrackIndex = index;
        }
        loadTrack(currentTrackIndex);
    } else if (index < currentTrackIndex) {
        currentTrackIndex--;
    }
    
    renderPlaylist();
    renderLibrary();
}

function clearPlaylist() {
    if (currentPlaylist.length === 0) return;
    if (!confirm('Remove all songs from the playlist?')) return;
    
    currentPlaylist = [];
    savePlaylist();
    audio.pause();
    nowPlaying.textContent = 'No songs in playlist';
    playBtn.textContent = '▶';
    renderPlaylist();
    renderLibrary();
}

function resetPlaylist() {
    const defaultSongs = getSongsByIds(DEFAULT_PLAYLIST_IDS);
    if (defaultSongs.length === 0) return;
    
    currentPlaylist = defaultSongs;
    savePlaylist();
    currentTrackIndex = 0;
    loadTrack(0);
    renderPlaylist();
    renderLibrary();
}

// ============================================================
// PLAYER FUNCTIONS
// ============================================================
function loadTrack(index) {
    if (currentPlaylist.length === 0) {
        audio.pause();
        nowPlaying.textContent = 'No songs in playlist';
        playBtn.textContent = '▶';
        return;
    }
    
    if (isShuffled) {
        if (index < 0) index = shuffledOrder.length - 1;
        if (index >= shuffledOrder.length) index = 0;
        currentShuffledIndex = index;
        const actualIndex = shuffledOrder[currentShuffledIndex];
        currentTrackIndex = actualIndex;
    } else {
        if (index < 0) index = currentPlaylist.length - 1;
        if (index >= currentPlaylist.length) index = 0;
        currentTrackIndex = index;
    }
    
    const track = currentPlaylist[currentTrackIndex];
    if (!track) return;
    
    audio.src = track.file;
    nowPlaying.textContent = track.title;
    playBtn.textContent = '⏸';
    audio.play();
    renderPlaylist();
    renderLibrary();
}

function togglePlay() {
    if (currentPlaylist.length === 0) return;
    
    if (audio.paused) {
        audio.play();
        playBtn.textContent = '⏸';
    } else {
        audio.pause();
        playBtn.textContent = '▶';
    }
}

function playNext() {
    if (currentPlaylist.length === 0) return;
    
    if (isShuffled) {
        loadTrack(currentShuffledIndex + 1);
    } else {
        loadTrack(currentTrackIndex + 1);
    }
}

function playPrev() {
    if (currentPlaylist.length === 0) return;
    
    if (isShuffled) {
        loadTrack(currentShuffledIndex - 1);
    } else {
        loadTrack(currentTrackIndex - 1);
    }
}

function toggleShuffle() {
    isShuffled = !isShuffled;
    shuffleBtn.classList.toggle('active', isShuffled);
    shuffleBtn.style.color = isShuffled ? '#00ffaa' : 'inherit';
    
    if (isShuffled) {
        shuffledOrder = Array.from({length: currentPlaylist.length}, (_, i) => i);
        for (let i = shuffledOrder.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [shuffledOrder[i], shuffledOrder[j]] = [shuffledOrder[j], shuffledOrder[i]];
        }
        const currentIndex = shuffledOrder.indexOf(currentTrackIndex);
        currentShuffledIndex = currentIndex !== -1 ? currentIndex : 0;
        document.getElementById('playlist-status').textContent = '(🔀 shuffled)';
    } else {
        document.getElementById('playlist-status').textContent = `(${currentPlaylist.length} songs)`;
        if (currentTrackIndex >= currentPlaylist.length) {
            currentTrackIndex = 0;
            loadTrack(0);
        }
    }
}

function toggleRepeat() {
    const modes = ['none', 'all', 'one'];
    const currentIndex = modes.indexOf(repeatMode);
    const nextIndex = (currentIndex + 1) % modes.length;
    repeatMode = modes[nextIndex];
    
    switch(repeatMode) {
        case 'none':
            repeatBtn.textContent = '🔁';
            repeatBtn.style.color = 'inherit';
            repeatBtn.title = 'Repeat: Off';
            break;
        case 'all':
            repeatBtn.textContent = '🔁';
            repeatBtn.style.color = '#00ffaa';
            repeatBtn.title = 'Repeat: All';
            break;
        case 'one':
            repeatBtn.textContent = '🔂';
            repeatBtn.style.color = '#00ffaa';
            repeatBtn.title = 'Repeat: One';
            break;
    }
}

function handleSongEnd() {
    if (currentPlaylist.length === 0) return;
    
    switch(repeatMode) {
        case 'none':
            if (isShuffled) {
                if (currentShuffledIndex < shuffledOrder.length - 1) {
                    playNext();
                } else {
                    playBtn.textContent = '▶';
                }
            } else {
                if (currentTrackIndex < currentPlaylist.length - 1) {
                    playNext();
                } else {
                    playBtn.textContent = '▶';
                }
            }
            break;
        case 'all':
            if (isShuffled) {
                if (currentShuffledIndex >= shuffledOrder.length - 1) {
                    shuffledOrder = Array.from({length: currentPlaylist.length}, (_, i) => i);
                    for (let i = shuffledOrder.length - 1; i > 0; i--) {
                        const j = Math.floor(Math.random() * (i + 1));
                        [shuffledOrder[i], shuffledOrder[j]] = [shuffledOrder[j], shuffledOrder[i]];
                    }
                    loadTrack(0);
                } else {
                    playNext();
                }
            } else {
                if (currentTrackIndex >= currentPlaylist.length - 1) {
                    loadTrack(0);
                } else {
                    playNext();
                }
            }
            break;
        case 'one':
            audio.currentTime = 0;
            audio.play();
            break;
    }
}

// ============================================================
// EVENT LISTENERS
// ============================================================
volumeControl.addEventListener('input', function() {
    audio.volume = this.value;
});

audio.addEventListener('timeupdate', function() {
    if (audio.duration) {
        const percent = (audio.currentTime / audio.duration) * 100;
        progress.style.width = percent + '%';
        currentTimeDisplay.textContent = formatTime(audio.currentTime);
        totalTimeDisplay.textContent = formatTime(audio.duration);
    }
});

progressBar.addEventListener('click', function(e) {
    const rect = this.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const percent = x / rect.width;
    audio.currentTime = percent * audio.duration;
});

function formatTime(seconds) {
    if (isNaN(seconds)) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs.toString().padStart(2, '0')}`;
}

audio.addEventListener('ended', handleSongEnd);
audio.addEventListener('play', function() {
    playBtn.textContent = '⏸';
});
audio.addEventListener('pause', function() {
    playBtn.textContent = '▶';
});

document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    
    switch(e.key) {
        case ' ':
            e.preventDefault();
            togglePlay();
            break;
        case 'ArrowRight':
            e.preventDefault();
            playNext();
            break;
        case 'ArrowLeft':
            e.preventDefault();
            playPrev();
            break;
        case 's':
        case 'S':
            toggleShuffle();
            break;
        case 'r':
        case 'R':
            toggleRepeat();
            break;
    }
});

// ============================================================
// INITIALIZATION
// ============================================================
function init() {
    currentPlaylist = getPlaylist();
    
    renderPlaylist();
    renderLibrary();
    
    if (currentPlaylist.length > 0) {
        const savedTrack = localStorage.getItem('lastTrack');
        const savedTime = localStorage.getItem('lastTime');
        
        if (savedTrack !== null && parseInt(savedTrack) < currentPlaylist.length) {
            currentTrackIndex = parseInt(savedTrack);
            loadTrack(currentTrackIndex);
            if (savedTime) {
                audio.currentTime = parseFloat(savedTime);
            }
        } else {
            loadTrack(0);
        }
        
        const savedShuffle = localStorage.getItem('isShuffled');
        if (savedShuffle === 'true') {
            toggleShuffle();
        }
        
        const savedRepeat = localStorage.getItem('repeatMode');
        if (savedRepeat && ['none', 'all', 'one'].includes(savedRepeat)) {
            repeatMode = savedRepeat;
            switch(repeatMode) {
                case 'all':
                    repeatBtn.textContent = '🔁';
                    repeatBtn.style.color = '#00ffaa';
                    break;
                case 'one':
                    repeatBtn.textContent = '🔂';
                    repeatBtn.style.color = '#00ffaa';
                    break;
            }
        }
    }
    
    window.addEventListener('beforeunload', function() {
        localStorage.setItem('lastTrack', currentTrackIndex);
        localStorage.setItem('lastTime', audio.currentTime);
        localStorage.setItem('repeatMode', repeatMode);
        localStorage.setItem('isShuffled', isShuffled);
    });
}

init();
</script>