}

.music-player p {
    color: var(--text-color);
}

/* Fix for any remaining white backgrounds */
section.music-player {
    background-color: transparent;
}

/* Smooth transitions */
.player-controls,
.playlist-section,
.library-section,
#playlist li,
#library li,
.controls button,
.volume-control input[type="range"],
#audio-player {
    transition: background-color 0.3s ease-in-out,
                color 0.3s ease-in-out,
                border-color 0.3s ease-in-out;
}

/* Mobile responsiveness */
@media (max-width: 600px) {
    .playlist-header {
        flex-direction: column;
        align-items: flex-start;
    }
    
    #playlist li,
    #library li {
        padding: 8px 10px;
        flex-wrap: wrap;
    }
    
    #playlist li .song-info {
        min-width: 0;
    }
    
    #library li .song-title {
        font-size: 0.9em;
    }
    
    .library-header {
        font-size: 0.85em;
        padding: 6px 12px;
        flex-wrap: wrap;
