function renderPlaylist() {
    playlistEl.innerHTML = '';
    
    if (currentPlaylist.length === 0) {
        playlistEl.innerHTML = '<li style="text-align:center; color:var(--secondary-text); padding:20px; cursor:default;">No songs in playlist. Add some from the library below! 🎵</li>';
        playlistStatus.textContent = '(0 songs)';
        return;
    }
    
    currentPlaylist.forEach((song, index) => {
        const li = document.createElement('li');
        li.dataset.index = index;
        li.className = index === currentTrackIndex ? 'active' : '';
        
        // Click handler to play the song
        li.addEventListener('click', function() {
            loadTrack(index);
        });
        
        // ✅ ADDED: Section name column
        li.innerHTML = `
            <div class="song-info">
                <span class="play-indicator">▶</span>
                <span class="song-title">${song.title}</span>
            </div>
            <span class="song-section">${song.section || ''}</span>
            <span class="song-duration">${song.duration}</span>
            <button class="remove-btn" onclick="removeFromPlaylist(${index})" title="Remove from playlist">✕</button>
        `;
        
        playlistEl.appendChild(li);
    });
    
    playlistStatus.textContent = `(${currentPlaylist.length} songs)`;
    updateActiveHighlight();
}

// ✅ ADD: Search state
let searchQuery = '';

// ============================================================
// LOAD ALL FUNCTION - Loads only visible/filtered songs
// ============================================================
function loadAllToPlaylist() {
    const btn = document.querySelector('#loadAllBtn');
    if (!btn || btn.disabled) return;
    
    // Get the currently filtered songs
    const songsToLoad = getFilteredSongs();
    
    btn.disabled = true;
    btn.textContent = '⏳ Loading...';
    
    let addedCount = 0;
    const songsToAdd = [];
    
    songsToLoad.forEach(song => {
        if (!currentPlaylist.some(s => s.id === song.id)) {
            songsToAdd.push(song);
            addedCount++;
        }
    });
    
    if (addedCount > 0) {
        songsToAdd.forEach(song => currentPlaylist.push(song));
        savePlaylist();
        renderPlaylist();
        renderLibrary();
        
        if (currentPlaylist.length > 0 && currentPlaylist.length === songsToAdd.length) {
            const firstSongId = songsToAdd[0].id;
            const index = currentPlaylist.findIndex(s => s.id === firstSongId);
            if (index !== -1) {
                loadTrack(index);
            }
        }
    }
    
    btn.disabled = false;
    btn.textContent = '➕ Load All Songs';
}
// ============================================================
// HELPER: Get currently filtered songs
// ============================================================
function getFilteredSongs() {
    const query = searchQuery.toLowerCase().trim();
    
    if (window._exactMatchMode && window._exactSection && window._exactSong) {
        const sectionToMatch = window._exactSection.toLowerCase().trim();
        const songToMatch = window._exactSong.toLowerCase().trim();
        
        return allSongs.filter(song => {
            const songSection = (song.section || '').toLowerCase().trim();
            const songTitle = song.title.toLowerCase().trim();
            return songSection === sectionToMatch && songTitle === songToMatch;
        });
    }
    
    if (!query) {
        return allSongs;
    }
    
    const searchWords = query.split(/\s+/).filter(word => word.length > 0);
    const requiredWords = [];
    const negatedWords = [];
    
    searchWords.forEach(word => {
        if (word.startsWith('~')) {
            const cleanWord = word.substring(1).toLowerCase();
            if (cleanWord) negatedWords.push(cleanWord);
        } else {
            requiredWords.push(word.toLowerCase());
        }
    });
    
    if (requiredWords.length === 0 && negatedWords.length > 0) {
        return allSongs.filter(song => {
            const searchableText = [
                song.title.toLowerCase(),
                song.section ? song.section.toLowerCase() : '',
                song.date ? song.date.toLowerCase() : ''
            ].join(' ');
            return negatedWords.every(negWord => !searchableText.includes(negWord));
        });
    }
    
    return allSongs.filter(song => {
        const searchableText = [
            song.title.toLowerCase(),
            song.section ? song.section.toLowerCase() : '',
            song.date ? song.date.toLowerCase() : ''
        ].join(' ');
        const hasAllRequired = requiredWords.every(word => searchableText.includes(word));
        const hasAnyNegated = negatedWords.some(word => searchableText.includes(word));
        return hasAllRequired && !hasAnyNegated;
    });
}
// ============================================================
// LOAD TRACK WITHOUT AUTO-PLAYING
// ============================================================
function loadTrackSilent(index) {
    if (currentPlaylist.length === 0) {
        audio.pause();
        nowPlaying.textContent = 'No songs in playlist';
        playBtn.textContent = '▶';
        return;
    }
    
    if (isShuffled) {
        if (index < 0) index = shuffledOrder.length - 1;
        if (index >= shuffledOrder.length) index = 0;
        currentShuffledIndex = index;
        const actualIndex = shuffledOrder[currentShuffledIndex];
        currentTrackIndex = actualIndex;
    } else {
        if (index < 0) index = currentPlaylist.length - 1;
        if (index >= currentPlaylist.length) index = 0;
        currentTrackIndex = index;
    }
    
    const track = currentPlaylist[currentTrackIndex];
    if (!track) return;
    
    // Load the audio source but don't play
    audio.src = track.file;
    nowPlaying.textContent = track.title;
    // Keep the play button in pause state
    playBtn.textContent = '▶';
    // Don't call audio.play()
    updateActiveHighlight(); // Just update the highlight
}

function renderLibrary() {
    libraryEl.innerHTML = '';
    
    const playlistIds = currentPlaylist.map(song => song.id);
    let query = searchQuery.toLowerCase().trim();
    
    // ✅ HANDLE EXACT MATCHING (from URL parameters)
    let filteredSongs = allSongs;
    let hasActiveSearch = false;
    
    // Check if we're in exact match mode (from URL params)
    if (window._exactMatchMode && window._exactSection && window._exactSong) {
        // Filter by exact section name (case-insensitive exact match)
        const sectionToMatch = window._exactSection.toLowerCase().trim();
        const songToMatch = window._exactSong.toLowerCase().trim();
        
        filteredSongs = allSongs.filter(song => {
            const songSection = (song.section || '').toLowerCase().trim();
            const songTitle = song.title.toLowerCase().trim();
            
            const sectionMatch = songSection === sectionToMatch;
            const songMatch = songTitle === songToMatch;
            
            return sectionMatch && songMatch;
        });
        
        // If we found exactly one result and autoplay is enabled, load it silently
        if (filteredSongs.length === 1 && window._autoPlay) {
            const foundSong = filteredSongs[0];
            let playlistIndex = currentPlaylist.findIndex(s => s.id === foundSong.id);
            if (playlistIndex === -1) {
                currentPlaylist.push(foundSong);
                savePlaylist();
                renderPlaylist();
                playlistIndex = currentPlaylist.length - 1;
            }
            
            setTimeout(() => {
                if (currentPlaylist.length > 0 && playlistIndex < currentPlaylist.length) {
                    const track = currentPlaylist[playlistIndex];
                    audio.src = track.file;
                    nowPlaying.textContent = track.title;
                    playBtn.textContent = '▶';
                    currentTrackIndex = playlistIndex;
                    updateActiveHighlight();
                }
            }, 100);
        }
        
        hasActiveSearch = true;
        
    } else if (query) {
        // ✅ ENHANCED: Split query into words and identify negated terms
        const searchWords = query.split(/\s+/).filter(word => word.length > 0);
        const requiredWords = [];
        const negatedWords = [];
        
        // Separate required and negated words
        searchWords.forEach(word => {
            if (word.startsWith('~')) {
                // Remove the ~ and add to negated list
                const cleanWord = word.substring(1).toLowerCase();
                if (cleanWord) negatedWords.push(cleanWord);
            } else {
                requiredWords.push(word.toLowerCase());
            }
        });
        
        // If there are no required words, use all non-negated words
        if (requiredWords.length === 0 && negatedWords.length > 0) {
            // If only negated words, show all songs that don't have those terms
            filteredSongs = allSongs.filter(song => {
                const searchableText = [
                    song.title.toLowerCase(),
                    song.section ? song.section.toLowerCase() : '',
                    song.date ? song.date.toLowerCase() : ''
                ].join(' ');
                
                // All songs where NONE of the negated words appear
                return negatedWords.every(negWord => !searchableText.includes(negWord));
            });
        } else {
            // Normal search with required words and optional negations
            filteredSongs = allSongs.filter(song => {
                // Create a combined searchable text for each song
                const searchableText = [
                    song.title.toLowerCase(),
                    song.section ? song.section.toLowerCase() : '',
                    song.date ? song.date.toLowerCase() : ''
                ].join(' ');
                
                // Check if ALL required words are found in the searchable text
                const hasAllRequired = requiredWords.every(word => searchableText.includes(word));
                
                // Check if ANY negated words are found (should NOT be found)
                const hasAnyNegated = negatedWords.some(word => searchableText.includes(word));
                
                // Song passes if it has all required words AND no negated words
                return hasAllRequired && !hasAnyNegated;
            });
        }
        
        hasActiveSearch = true;
    }
    
    if (filteredSongs.length === 0) {
        libraryEl.innerHTML = `
            <div class="no-results">
                <span class="emoji">🔍</span>
                No songs found matching "<strong>${searchQuery}</strong>"
            </div>
        `;
        libraryCount.textContent = `(${allSongs.length} songs)`;
        return;
    }
    
    // Group filtered songs by section
    const sections = {};
    filteredSongs.forEach(song => {
        const sectionName = song.section || 'Other';
        if (!sections[sectionName]) {
            sections[sectionName] = [];
        }
        sections[sectionName].push(song);
    });
    
    // Render each section
    Object.keys(sections).forEach(sectionName => {
        const songsInSection = sections[sectionName];
        const allInPlaylist = songsInSection.every(song => playlistIds.includes(song.id));
        const noneInPlaylist = songsInSection.every(song => !playlistIds.includes(song.id));
        
        // Determine if this section should be expanded
        let isExpanded;
        
        if (hasActiveSearch) {
            isExpanded = true;
        }
        else if (manualSectionStates[sectionName] !== undefined) {
            isExpanded = manualSectionStates[sectionName];
        } else {
            isExpanded = sectionDefaults[sectionName] !== undefined 
                ? sectionDefaults[sectionName] 
                : DEFAULT_SECTION_STATE;
        }
        
        // Add section header with toggle
        const header = document.createElement('div');
        header.className = 'library-header';
        header.style.cursor = 'pointer';
        header.dataset.section = sectionName;
        header.dataset.expanded = isExpanded ? 'true' : 'false';
        
        // Click handler
        header.addEventListener('click', function(e) {
            if (e.target.classList.contains('load-section-btn')) return;
            if (e.target.closest('.load-section-btn')) return;
            toggleSection(this.dataset.section);
        });
        
        // Header content wrapper
        const headerContent = document.createElement('div');
        headerContent.style.cssText = 'display:flex; align-items:center; gap:10px; flex:1;';
        
        // Toggle icon
        const toggleIcon = document.createElement('span');
        toggleIcon.className = 'toggle-icon';
        toggleIcon.textContent = isExpanded ? '▼' : '▶';
        toggleIcon.style.cssText = 'font-size:0.7em; transition:transform 0.2s;';
        headerContent.appendChild(toggleIcon);
        
        // Section name
        const headerText = document.createElement('span');
        headerText.textContent = sectionName;
        headerContent.appendChild(headerText);
        
        header.appendChild(headerContent);
        
        // Load All button
        if (!allInPlaylist) {
            const loadBtn = document.createElement('button');
            loadBtn.className = 'load-section-btn';
            loadBtn.textContent = noneInPlaylist ? '➕ Load All' : '➕ Add Missing';
            loadBtn.onclick = function(e) {
                e.stopPropagation();
                loadSectionToPlaylist(sectionName);
            };
            header.appendChild(loadBtn);
        } else {
            const badge = document.createElement('span');
            badge.style.cssText = 'font-size:0.6em; color:var(--secondary-text); font-weight:normal;';
            badge.textContent = '✅ All loaded';
            header.appendChild(badge);
        }
        
        libraryEl.appendChild(header);
        
        // Add songs in this section
        const ul = document.createElement('ul');
        ul.style.display = isExpanded ? '' : 'none';
        
        songsInSection.forEach(song => {
            const li = document.createElement('li');
            const isInPlaylist = playlistIds.includes(song.id);
            
            li.innerHTML = `
                <span class="song-title">${song.title}</span>
                <span class="song-duration">${song.duration}</span>
                ${isInPlaylist 
                    ? '<span class="added-badge">✅ In Playlist</span>'
                    : `<button class="add-btn" onclick="addToPlaylist(${song.id})" title="Add to playlist">➕</button>`
                }
            `;
            
            li.addEventListener('click', function(e) {
                if (e.target.tagName === 'BUTTON') return;
                
                const playlistIndex = currentPlaylist.findIndex(s => s.id === song.id);
                if (playlistIndex !== -1) {
                    loadTrack(playlistIndex);
                } else {
                    addToPlaylist(song.id);
                    const newIndex = currentPlaylist.findIndex(s => s.id === song.id);
                    if (newIndex !== -1) {
                        loadTrack(newIndex);
                    }
                }
            });
            
            ul.appendChild(li);
        });
        libraryEl.appendChild(ul);
    });
    
    // Update count showing filtered results
    if (query || window._exactMatchMode) {
        libraryCount.textContent = `(${filteredSongs.length} of ${allSongs.length} songs)`;
    } else {
        libraryCount.textContent = `(${allSongs.length} songs)`;
    }
}

