title: "Music"
layout: "base.njk"
---

<h1>My Music</h1>

<p>Here are some of my recordings. The default playlist features my latest songs. You can customize your playlist by adding or removing songs below!</p>

<section class="music-player">
    <div class="player-controls">
        <h3 id="now-playing">Higher Dimensions (Alien Thoughts EP)</h3>
        <audio id="audio-player" controls autoplay>
            <source src="https://www.dropbox.com/scl/fi/ixe7ej7nn9pi8sule3mh5/1-Higher-Dimensions-by-E9.mp3?rlkey=z6r89fk93fnhxxjir14jm79c6&st=94v061iu&raw=1" type="audio/mpeg">
            Your browser does not support audio.
        </audio>
        
        <!-- Progress Bar -->
        <div class="progress-container">
            <div class="progress-bar" id="progress-bar">
                <div class="progress" id="progress"></div>
            </div>
            <div class="time-info">
                <span id="current-time">0:00</span>
                <span id="total-time">0:00</span>
            </div>
        </div>
        
        <!-- Controls -->
        <div class="controls">
            <button onclick="toggleShuffle()" id="shuffle-btn" title="Shuffle (S)">🔀</button>
            <button onclick="playPrev()" title="Previous (←)">⏮</button>
            <button onclick="togglePlay()" id="play-btn" title="Play/Pause (Space)">⏸</button>
            <button onclick="playNext()" title="Next (→)">⏭</button>
            <button onclick="toggleRepeat()" id="repeat-btn" title="Repeat (R)">🔁</button>
        </div>
        
        <!-- Volume Control -->
        <div class="volume-control">
            <span>🔊</span>
            <input type="range" min="0" max="1" step="0.01" value="0.8" id="volume-control">
        </div>
    </div>

    <!-- Custom Playlist Section -->
    <div class="playlist-section">
        <div class="playlist-header">
            <h3>Now Playing <span id="playlist-status">(4 songs)</span></h3>
            <div class="playlist-actions">
                <button onclick="clearPlaylist()" class="action-btn" title="Clear Playlist">🗑️ Clear</button>
                <button onclick="resetPlaylist()" class="action-btn" title="Reset to Default">↩️ Reset</button>
            </div>
        </div>
        <ul id="playlist">
            <!-- Playlist items will be rendered here -->
        </ul>
    </div>

    <!-- Library Section -->
    <div class="library-section">
        <h3>All Songs <span id="library-count">(8 songs)</span></h3>
        <p class="library-hint">Click ➕ to add a song to your playlist, or click on a song title to play it immediately.</p>
        <div id="library">
            <!-- Library items with headers will be rendered here -->
        </div>
    </div>
</section>

<style>
/* Music Player - Dark mode fixes */
.player-controls {
    background-color: var(--card-bg);
    color: var(--text-color);
    padding: 30px;
    border-radius: 10px;
    margin-bottom: 30px;
    text-align: center;
    border: 1px solid var(--border-color);
}

/* Fix for the audio player element itself */
#audio-player {
    width: 100%;
    margin-bottom: 20px;
    background-color: var(--card-bg);
    border-radius: 5px;
}

/* Audio player custom styling for dark mode */
audio {
    background-color: var(--card-bg);
    border-radius: 5px;
}

/* Style the audio player controls */
audio::-webkit-media-controls-panel {
    background-color: var(--card-bg);
}

audio::-webkit-media-controls-current-time-display,
audio::-webkit-media-controls-time-remaining-display {
    color: var(--text-color);
}

/* Firefox audio player */
audio::-moz-range-track {
    background-color: var(--border-color);
}

audio::-moz-range-thumb {
    background-color: var(--link-color);
}

/* Playlist Section */
.playlist-section {
    background-color: var(--card-bg);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    margin-bottom: 20px;
}

.playlist-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
}

.playlist-section h3 {
    color: var(--text-color);
    margin: 0;
}

#playlist-status {
    font-weight: normal;
    font-size: 0.8em;
    color: var(--secondary-text);
}

.playlist-actions {
    display: flex;
    gap: 8px;
}

.action-btn {
    background: var(--active-bg);
    color: var(--active-text);
    border: none;
    padding: 5px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8em;
    transition: all 0.2s;
}

.action-btn:hover {
    opacity: 0.8;
    transform: scale(1.05);
}

/* Library Section */
.library-section {
    background-color: var(--card-bg);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
}

.library-section h3 {
    color: var(--text-color);
    margin-top: 0;
    margin-bottom: 5px;
}

.library-hint {
    color: var(--secondary-text);
    font-size: 0.85em;
    margin-bottom: 15px;
}

#library-count {
    font-weight: normal;
    font-size: 0.8em;
    color: var(--secondary-text);
}

/* Library Section Headers */
.library-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    padding: 8px 15px;
    background-color: var(--playlist-hover);
    border-radius: 20px;
    font-weight: 600;
    color: var(--text-color);
    font-size: 1.15em;
    border-bottom: 5px solid var(--link-color);
}

.library-header:first-of-type {
    margin-top: 0;
}

.library-header .load-section-btn {
    background: var(--link-color);
    color: white;
    border: none;
    padding: 4px 14px;
    border-radius: 15px;
    cursor: pointer;
    font-size: 0.6em;
    font-weight: 600;
    transition: all 0.2s;
}

.library-header .load-section-btn:hover {
    transform: scale(1.05);
    opacity: 0.9;
}

.library-header .load-section-btn:active {
    transform: scale(0.95);
}

/* Shared playlist styles */
#playlist,
#library ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

#playlist li,
#library li {
    padding: 10px 15px;
    border-bottom: 1px solid var(--border-color);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background-color 0.2s;
    position: relative;
    color: var(--text-color);
    gap: 10px;
}

#playlist li:last-child,
#library li:last-child {
    border-bottom: none;
}

/* Playlist items */
#playlist li {
    cursor: default;
}

#playlist li .song-info {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
}

#playlist li .song-title {
    color: var(--text-color);
