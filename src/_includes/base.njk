<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | {{ site.title }}</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS Feed" href="/feed.xml">
    <!-- Optional: Favicon -->
    <link rel="icon" type="image/png" href="/images/E9 Logo.png">
</head>
<body>
<nav>
    <div class="nav-container">
        <!-- Logo - Left side -->
        <div class="nav-logo">
            <a href="/" title="Right-click or long-press to toggle dark mode">
                <img src="/images/E9 Logo No Background.svg" alt="{{ site.title }}" class="logo-img logo-light">
                <img src="/images/E9 Logo No Background White.svg" alt="{{ site.title }}" class="logo-img logo-dark">
            </a>
        </div>

        <!-- Hamburger button - Right side (only visible on mobile) -->
        <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="nav-links">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>

        <!-- Navigation Links - Center on desktop, drawer on mobile -->
        <div class="nav-links" id="nav-links">
            <a href="/blog/">Blog</a>
            <a href="/music/">Music</a>
            <a href="/downloads/">Downloads</a>
            <a href="/calendar/">Calendar</a>
            <a href="/tools/">Tools</a>
            <a href="/lessons/">Lessons</a>
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/feed.xml" class="rss-link" title="Subscribe to RSS Feed">📡 RSS</a>
            <a href="https://venmo.com/EliPage" target="_blank" class="support-nav-link">☕ Support</a>
        </div>
    </div>
</nav>
    <main>
        {{ content | safe }}
  <!-- Only show share buttons on blog posts -->
    {% if layout == "base.njk" and tags and tags.includes("blog") %}
    <div class="share-buttons">
        <span>Share this post:</span>
        <a href="https://twitter.com/intent/tweet?text={{ title }}&url={{ site.url }}{{ page.url }}" target="_blank" class="share-btn twitter">🐦 Twitter</a>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ site.url }}{{ page.url }}" target="_blank" class="share-btn facebook">📘 Facebook</a>
		<button onclick="copyPageUrl()" class="share-btn instagram">📸 Copy Link</button>
        <a href="mailto:?subject={{ title }}&body=Check out this post: {{ site.url }}{{ page.url }}" class="share-btn email">✉️ Email</a>
    </div>
    {% endif %}
    </main>

<footer>
    <div class="footer-content">
        <div class="footer-brand">
            <img src="/images/E9 Logo.png" alt="{{ site.title }}" class="footer-logo">
            <p>&copy; {{ site.year }} {{ site.name }}</p>
        </div>
<div class="footer-links">
            <a href="/feed.xml" class="rss-link" title="Subscribe to RSS Feed">📡 RSS Feed</a>
            <!-- your existing support link -->
        </div>
        <div class="footer-support">
            <span>Support my work:</span>
            <a href="https://venmo.com/EliPage" target="_blank" class="footer-support-btn">
               Tip with Venmo
            </a>
        </div>
    </div>
</footer>

<script>
function copyPageUrl() {
    const url = window.location.href;
    navigator.clipboard.writeText(url);
    alert('Link copied to clipboard!');
}

// ------------------------------------------------------------
// MOBILE NAV — hamburger toggle
// ------------------------------------------------------------
const navToggle = document.getElementById('nav-toggle');
const navLinks = document.getElementById('nav-links');

if (navToggle && navLinks) {
    navToggle.addEventListener('click', function() {
        const isOpen = navLinks.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    // Close the menu when a link is tapped
    navLinks.addEventListener('click', function(e) {
        if (e.target.tagName === 'A') {
            navLinks.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
        }
    });

    // Close the menu if the user resizes past the breakpoint
    window.addEventListener('resize', function() {
        if (window.innerWidth > 900) {
            navLinks.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
        }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && navLinks.classList.contains('open')) {
            navLinks.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
        }
    });
}
	
// ------------------------------------------------------------
// THEME TOGGLE — desktop right-click + mobile long-press
// ------------------------------------------------------------
(function() {
    const html = document.documentElement;
    const logoLink = document.querySelector('.nav-logo a');

    // Apply saved theme (default dark)
    const savedTheme = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', savedTheme);
    if (!localStorage.getItem('theme')) {
        localStorage.setItem('theme', 'dark');
    }

    function toggleTheme() {
        const currentTheme = html.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
    }

    if (!logoLink) return;

    // ------------------------------------------------------------
    // Unified handler: fires from right-click, Android long-press
    // (via contextmenu), and iOS long-press (via touch timer).
    // ------------------------------------------------------------
    let handledByContextMenu = false;

    logoLink.addEventListener('contextmenu', function(e) {
        e.preventDefault();               // suppress browser menu / link preview
        handledByContextMenu = true;
        toggleTheme();
        // Reset the flag after this interaction settles
        setTimeout(() => { handledByContextMenu = false; }, 1000);
    });

    // Touch fallback — only runs if contextmenu didn't already fire
    // (i.e., on iOS Safari, which doesn't fire contextmenu for links)
    let pressTimer = null;
    let longPressTriggered = false;
    const LONG_PRESS_MS = 600;

    logoLink.addEventListener('touchstart', function() {
        longPressTriggered = false;
        handledByContextMenu = false;
        pressTimer = setTimeout(() => {
            pressTimer = null;
            if (handledByContextMenu) return;   // Android already handled it
            longPressTriggered = true;
            if (navigator.vibrate) navigator.vibrate(15);
            toggleTheme();
        }, LONG_PRESS_MS);
    }, { passive: true });

    logoLink.addEventListener('touchmove', function() {
        if (pressTimer) {
            clearTimeout(pressTimer);
            pressTimer = null;
        }
    }, { passive: true });

    logoLink.addEventListener('touchend', function(e) {
        if (pressTimer) {
            clearTimeout(pressTimer);
            pressTimer = null;
        }
        if (longPressTriggered) {
            e.preventDefault();  // prevent the click that would follow
            longPressTriggered = false;
        }
    });

    logoLink.addEventListener('touchcancel', function() {
        if (pressTimer) {
            clearTimeout(pressTimer);
            pressTimer = null;
        }
    });

    // Keyboard accessibility
    logoLink.addEventListener('keydown', function(e) {
        if (e.key === 't' || e.key === 'T') {
            e.preventDefault();
            toggleTheme();
        }
    });
})();
</script>
</body>
</html>