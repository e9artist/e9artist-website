<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | {{ site.title }}</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS Feed" href="/feed.xml">
    <!-- Optional: Favicon -->
    <link rel="icon" type="image/png" href="/images/E9 Logo.png">
</head>
<body>
    <nav>
        <div class="nav-container">
            <!-- Logo - Left side -->
            <div class="nav-logo">
                <a href="/">
               <!--     <img src="/images/E9 Logo No Background.png" alt="{{ site.title }}" class="logo-img"> -->
		    <!-- Light mode logo -->
        	    <img src="/images/E9 Logo No Background.png" alt="{{ site.title }}" class="logo-img logo-light">
        	    <!-- Dark mode logo -->
        	    <img src="/images/E9 Logo No Background White.png" alt="{{ site.title }}" class="logo-img logo-dark">
                </a>
            </div>
            
            <!-- Navigation Links - Right side -->
            <div class="nav-links">
		<a href="/blog/">Blog</a>
                <a href="/music/">Music</a>
                <a href="/downloads/">Downloads</a>
		<a href="/calendar/">Calendar</a>
		<a href="/tools/">Tools</a>
		<a href="/lessons/">Lessons</a>
		<a href="/about/">About</a>
                <a href="/contact/">Contact</a>
		<a href="/feed.xml" class="rss-link" title="Subscribe to RSS Feed">📡 RSS</a>
            <a href="https://venmo.com/EliPage" target="_blank" class="support-nav-link">☕ Support</a>
            </div>
            
            <!-- Theme toggle -->
            <button id="theme-toggle" aria-label="Toggle dark mode">
                ☀️
            </button>
        </div>
    </nav>

    <!-- ... rest of your content ... -->

    <main>
        {{ content | safe }}
  <!-- Only show share buttons on blog posts -->
    {% if layout == "base.njk" and tags and tags.includes("blog") %}
    <div class="share-buttons">
        <span>Share this post:</span>
        <a href="https://twitter.com/intent/tweet?text={{ title }}&url={{ site.url }}{{ page.url }}" target="_blank" class="share-btn twitter">🐦 Twitter</a>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ site.url }}{{ page.url }}" target="_blank" class="share-btn facebook">📘 Facebook</a>
       <!-- <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.url }}{{ page.url }}" target="_blank" class="share-btn linkedin">🔗 LinkedIn</a>-->
<button onclick="copyPageUrl()" class="share-btn instagram">📸 Copy Link</button>
        <a href="mailto:?subject={{ title }}&body=Check out this post: {{ site.url }}{{ page.url }}" class="share-btn email">✉️ Email</a>
    </div>
    {% endif %}
    </main>

<footer>
    <div class="footer-content">
        <div class="footer-brand">
            <img src="/images/E9 Logo.png" alt="{{ site.title }}" class="footer-logo">
            <p>&copy; {{ site.year }} {{ site.name }}</p>
        </div>
<div class="footer-links">
            <a href="/feed.xml" class="rss-link" title="Subscribe to RSS Feed">📡 RSS Feed</a>
            <!-- your existing support link -->
        </div>
        <div class="footer-support">
            <span>Support my work:</span>
            <a href="https://venmo.com/EliPage" target="_blank" class="footer-support-btn">
               Tip with Venmo
            </a>
        </div>
    </div>
</footer>

<script>
function copyPageUrl() {
    const url = window.location.href;
    navigator.clipboard.writeText(url);
    alert('Link copied to clipboard!');
}
    (function() {
        const themeToggle = document.getElementById('theme-toggle');
        const html = document.documentElement;
        
        // Check for saved theme preference
        const savedTheme = localStorage.getItem('theme');
        
        // If there's no saved preference, default to dark
        if (savedTheme) {
            html.setAttribute('data-theme', savedTheme);
            themeToggle.textContent = savedTheme === 'dark' ? '☀️' : '🌙';
        } else {
            // Default to dark mode
            html.setAttribute('data-theme', 'dark');
            themeToggle.textContent = '☀️';
            localStorage.setItem('theme', 'dark'); // Save the preference
        }
        
        // Toggle theme
        themeToggle.addEventListener('click', function() {
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            
            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            themeToggle.textContent = newTheme === 'dark' ? '☀️' : '🌙';
        });
    })();
</script>
</body>
</html>