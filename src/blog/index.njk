---
title: "Blog"
layout: "base.njk"
---

<h1>Blog</h1>

<p>Posts about my music projects, electronics builds, and guitar experiments.</p>

<ul class="post-list">
{% for post in collections.blog %}
    <li>
        <article>
            <h2>
                <a href="{{ post.url }}">{{ post.data.title }}</a>
            </h2>
            <time datetime="{{ post.date | isoDate }}">
                {{ post.date | readableDate }}
            </time>
            {% if post.data.tags %}
                <div class="tags">
                    Tags: {% for tag in post.data.tags %}
                        <span class="tag">{{ tag }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </article>
    </li>
{% endfor %}
</ul>