---
title: "Home"
layout: "base.njk"
---

<!-- Hero Section with Large Logo -->
<section class="hero">
    <div class="hero-content">
        <img src="/images/E9 Logo.png" alt="{{ site.title }}" class="hero-logo">
        <h1>{{ site.title }}</h1>
        <p class="tagline">{{ site.tagline }}</p>
        <div class="hero-cta">
            <a href="/music/" class="cta-button">Listen Now</a>
            <a href="/lessons/" class="cta-button secondary">Take Lessons</a>
        </div>
    </div>
</section>

<p>Hi, I'm {{ site.author }}. I'm a guitarist and electronics enthusiast.</p>

<section>
    <h2>Latest Blog Posts</h2>
    <ul>
    {% for post in collections.blog | reverse | limit(3) %}
        <li>
            <a href="{{ post.url }}">{{ post.data.title }}</a>
            <time>{{ post.date | readableDate }}</time>
        </li>
    {% endfor %}
    </ul>
    <a href="/blog/">View all posts →</a>
</section>

<section>
    <h2>Listen to My Music</h2>
    <audio controls>
        <source src="https://www.dropbox.com/scl/fi/nv8b7r1vm1s8tajy6b6u0/Higher-Dimensions-No-Guitar.mp3?rlkey=cqvcmduw1tcjsgre5m3hsjn2e&st=6rqy0wsy&raw=1" type="audio/wav">
        Your browser does not support audio.
    </audio>
</section>